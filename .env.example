# One database:
DATABASE_URL=postgresql://readonly_user:password@localhost:5432/shop

# ...or several, as JSON (name -> connection URL). Overrides DATABASE_URL.
# PG_MCP_DATABASES={"shop": "postgresql://...", "analytics": "postgresql://..."}

# Safety limits
PG_MCP_MAX_ROWS=200
PG_MCP_STATEMENT_TIMEOUT_MS=5000

# LLM for the `ask` tool (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, Ollama...)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
